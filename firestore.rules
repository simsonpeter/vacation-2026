rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function tripData(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }

    function isTripMember(tripId) {
      return signedIn() && request.auth.uid in tripData(tripId).members;
    }

    // Partner joining with invite code: not a member yet, adding themselves.
    function isAddingSelfAsMember() {
      return signedIn()
        && !(request.auth.uid in resource.data.members)
        && request.auth.uid in request.resource.data.members;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /inviteCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.tripId is string
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /trips/{tripId} {
      allow read: if signedIn() && (
        request.auth.uid in resource.data.members
        || resource.data.createdBy == request.auth.uid
      );
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.members
        && request.resource.data.inviteCode is string;
      // Members can edit; non-members may only join by adding themselves.
      allow update: if isTripMember(tripId) || isAddingSelfAsMember();
      allow delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;

      match /events/{eventId} {
        allow read, write: if isTripMember(tripId);
      }

      match /attachments/{attachmentId} {
        allow read, write: if isTripMember(tripId);
      }

      // Chunked file bytes for free native uploads (no paid Storage)
      match /attachmentChunks/{chunkId} {
        allow read, write: if isTripMember(tripId);
      }
    }
  }
}
