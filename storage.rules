rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isTripMember(tripId) {
      return signedIn()
        && request.auth.uid in firestore.get(/databases/(default)/documents/trips/$(tripId)).data.members;
    }

    match /trips/{tripId}/{allPaths=**} {
      allow read: if isTripMember(tripId);
      allow write: if isTripMember(tripId)
        && (request.resource == null || request.resource.size < 25 * 1024 * 1024);
    }
  }
}
